{
  "name": "@iurysza/opencode-cursor-sdk",
  "version": "0.0.0",
  "description": "OpenCode 2.x provider plugin backed by the Cursor SDK.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./dist/server.js",
    "./provider": "./dist/provider/factory.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@cursor/sdk": "1.0.37"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.min.json",
    "test": "vitest run test/unit",
    "test:host": "node test/t1/run-host.mjs",
    "test:t2": "node test/t2/run-offline.mjs",
    "test:t2-create": "node test/t2/run-create.mjs",
    "test:req": "node test/req/run-requests.mjs",
    "fixtures:acquire": "node test/matrix/acquire.mjs",
    "test:matrix": "node test/matrix/run-matrix.mjs"
  }
}
