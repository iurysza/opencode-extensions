{
  "name": "@iurysza/opencode-extensions",
  "version": "0.0.0",
  "description": "OpenCode extension packages maintained by Iury Souza.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/opencode-cursor-sdk",
    "packages/opencode-cursor-cloud"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:host": "npm run test:host --workspaces --if-present",
    "test:t2": "npm run test:t2 --workspaces --if-present",
    "test:t2-create": "npm run test:t2-create --workspaces --if-present",
    "test:req": "npm run test:req --workspaces --if-present",
    "check": "node --test scripts/*.test.mjs && node scripts/check-layout.mjs && npm run typecheck && npm test",
    "prepublishOnly": "node -e \"console.error('Refusing to publish the private root workspace.'); process.exit(1)\"",
    "fixtures:acquire": "npm run fixtures:acquire --workspaces --if-present",
    "test:matrix": "npm run test:matrix --workspaces --if-present",
    "check:packs": "node scripts/release-check.mjs pack",
    "test:bridge": "npm run test:bridge --workspaces --if-present",
    "test:hosttools": "npm run test:hosttools --workspaces --if-present",
    "test:control": "npm run test:control --workspaces --if-present",
    "test:tui": "npm run test:tui --workspaces --if-present",
    "test:composition": "npm run test:composition --workspaces --if-present"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "22.20.5",
    "opencode-plugin-min": "npm:@opencode/plugin@2.0.0",
    "solid-js": "1.9.16",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "^4.6.6"
  }
}
